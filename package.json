{
  "name": "faster",
  "version": "0.1.0",
  "description": "Accessible React UI primitives built with reusable CSS design tokens.",
  "license": "MIT",
  "main": "./dist/faster.umd.cjs",
  "module": "./dist/faster.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "src/tokens.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/faster.js",
      "require": "./dist/faster.umd.cjs"
    },
    "./styles.css": "./dist/faster.css",
    "./tokens.css": "./src/tokens.css"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && tsc -p tsconfig.types.json",
    "lint": "eslint .",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:e2e": "cypress run",
    "prepublishOnly": "npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "jest": "^30.4.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@chromatic-com/storybook": "latest",
    "@eslint/js": "^10.0.1",
    "@rolldown/plugin-babel": "^0.2.3",
    "@storybook/addon-a11y": "^10.5.9",
    "@storybook/addon-docs": "^10.5.9",
    "@storybook/addon-vitest": "^10.5.9",
    "@storybook/react-vite": "^10.5.9",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.5",
    "@types/babel__core": "^7.20.5",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/browser-playwright": "latest",
    "@vitest/coverage-v8": "latest",
    "babel-plugin-react-compiler": "^1.0.0",
    "cypress": "^15.21.0",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "eslint-plugin-storybook": "^10.5.9",
    "globals": "^17.7.0",
    "identity-obj-proxy": "^3.0.0",
    "jest-environment-jsdom": "^30.4.1",
    "playwright": "latest",
    "storybook": "^10.5.9",
    "tailwindcss": "^4.3.3",
    "ts-jest": "^29.4.12",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.0",
    "vitest": "latest"
  }
}
